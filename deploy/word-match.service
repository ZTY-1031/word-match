[Unit]
Description=Word Match (接词挑战)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/word-match
# -Xmx256m 足够 10 人规模；1C2G 的小机器也跑得动
ExecStart=/usr/bin/java -Dfile.encoding=UTF-8 -Xms128m -Xmx256m -jar /opt/word-match/app.jar --server.port=8080
Restart=always
RestartSec=3
SuccessExitStatus=143
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
